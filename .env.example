# Copy to .env.local and fill in. Never commit real values.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (Render Postgres in prod; docker compose locally). Accessed only via Drizzle/pg.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/charly
# Real-Postgres tests in `pnpm test` run only when TEST_DATABASE_URL is set in your SHELL
# (vitest doesn't read this file; CI always sets it). With the local DB running:
#   TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/charly_test pnpm test

# File storage (src/lib/storage.ts). Production: Cloudflare R2 (Decision Log 2026-11-24).
# STORAGE_DRIVER: s3 (R2 or local MinIO) | memory (tests/CI only)
STORAGE_DRIVER=s3
# Local MinIO from docker compose. R2: https://<account-id>.r2.cloudflarestorage.com, region auto
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=charly-dev
S3_ACCESS_KEY_ID=charly
S3_SECRET_ACCESS_KEY=charly-dev-secret

# Email (src/lib/email.ts). EMAIL_DRIVER: resend (prod) | console (dev/CI: logs instead of sending)
EMAIL_DRIVER=console
RESEND_API_KEY=
EMAIL_FROM="Charly's Corner Store <hello@example.com>"
OWNER_NOTIFY_EMAIL=CHARLYSCORNERSTORE@GMAIL.COM

# Cloudflare Turnstile. Values below are Cloudflare's published TEST keys (always pass);
# use the real keys from the Cloudflare dashboard in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Payments (Square — decided 2026-11-26, docs/02 Decision log).
# sandbox | production. Leave empty to disable payments.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Webhook endpoint URL Square signs (defaults to ${NEXT_PUBLIC_SITE_URL}/api/webhooks/square).
SQUARE_WEBHOOK_URL=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Proxies in front of the app that append to X-Forwarded-For (rate limiting uses the IP they saw).
# Render = 1. Add 1 if Cloudflare proxying is put in front of Render.
TRUSTED_PROXY_COUNT=1

# Coupons
COUPON_PERCENT_OFF=15
COUPON_EXPIRY_DAYS=365
COUPON_MIN_ORDER_CENTS=3000

# Accounts (2026-11-26)
# Encrypts authenticator-app secrets at rest. 32 bytes, base64: openssl rand -base64 32
# Required in production; dev/tests fall back to a public dev key when empty.
AUTH_ENCRYPTION_KEY=
# "Continue with Google": an OAuth client from Google Cloud Console (Web application).
# Authorized redirect URI: ${NEXT_PUBLIC_SITE_URL}/api/auth/google/callback
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
