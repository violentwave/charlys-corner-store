# Copy to .env.local and fill in. Never commit real values.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (Render Postgres in prod; any Postgres locally). Accessed only via Drizzle/pg.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/charly

# File storage: S3-compatible (DECIDE in docs/02: Cloudflare R2 vs Render disk). Used only by src/lib/storage.ts
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Charly's Corner Store <hello@example.com>"
OWNER_NOTIFY_EMAIL=CHARLYSCORNERSTORE@GMAIL.COM

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Payments (DECIDE: Square or Stripe; keep only one block)
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Coupons
COUPON_PERCENT_OFF=15
COUPON_EXPIRY_DAYS=365
COUPON_MIN_ORDER_CENTS=3000
